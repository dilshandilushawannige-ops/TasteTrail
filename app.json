{
  "expo": {
    "name": "Taste Trail",
    "slug": "TasteTrail",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tastetrail",
    "userInterfaceStyle": "light",
    "backgroundColor": "#E8505B",
    "ios": {
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Allow TasteTrail to use speech recognition to transcribe your recipes.",
        "NSMicrophoneUsageDescription": "Allow TasteTrail to use the microphone for voice recipe entry.",
        "NSLocationWhenInUseUsageDescription": "Allow TasteTrail to access your location to help you add restaurant locations and find nearby restaurants."
      }
    },
    "android": {
      "backgroundColor": "#E8505B",
      "adaptiveIcon": {
        "backgroundColor": "#E8505B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.dilshan2001.TasteTrail"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#E8505B",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 288,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#E8505B",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow TasteTrail to use the microphone for voice recipe entry.",
          "speechRecognitionPermission": "Allow TasteTrail to use speech recognition to transcribe your recipes.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      "@maplibre/maplibre-react-native",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "29d87eb0-6990-4be3-961d-200217c6c883"
      }
    }
  }
}
