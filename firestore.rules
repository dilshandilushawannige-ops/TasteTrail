rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Server time makes temporary blocks expire without a scheduled job.
    function accountAccessAllowed() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      return request.auth != null && (!exists(path)
        || !(get(path).data.get('blockedAt', null) is timestamp)
        || !(get(path).data.get('blockDurationDays', 0) in [7, 30])
        || request.time >= get(path).data.blockedAt + duration.value(get(path).data.blockDurationDays, 'd'));
    }
    
    // Helper function to check if user is admin
    function isAdmin() {
      // Check multiple possible admin claim structures
      return request.auth != null && (
        request.auth.token.admin == true ||
        request.auth.token.isAdmin == true ||
        request.auth.token.role == 'admin' ||
        ('admin' in request.auth.token.roles) ||
        (resource != null && request.auth.uid == resource.data.createdBy)
      );
    }
    
    // Restaurant collection rules
    match /restaurants/{restaurantId} {
      // Allow read for:
      // - Active restaurants (everyone authenticated)
      // - All restaurants (admins only)
      allow read: if request.auth != null && accountAccessAllowed() && (
        (resource.data.status == 'active') || isAdmin()
      );
      
      // Allow create: admins only
      allow create: if accountAccessAllowed() && isAdmin() &&
        // Ensure required fields are present for create
        request.resource.data.keys().hasAll([
          'name', 'category', 'status', 'createdBy', 'createdAt'
        ]) &&
        // Ensure createdBy matches current user
        request.resource.data.createdBy == request.auth.uid;
      
      // Allow update: admins only
      allow update: if accountAccessAllowed() && isAdmin() &&
        // Prevent changing createdBy and createdAt
        request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.createdAt == resource.data.createdAt;
      
      // Allow delete: admins only
      allow delete: if accountAccessAllowed() && isAdmin();
    }
    
    // Account settings only allow a user to manage their own profile.
    match /users/{userId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }

      // Only trusted authentication claims grant access to the full user list.
      function isUserAdmin() {
        return request.auth != null && accountAccessAllowed() && (
          request.auth.token.get('admin', false) == true ||
          request.auth.token.get('admin', false) == 'true' ||
          request.auth.token.get('isAdmin', false) == true ||
          request.auth.token.get('role', '') == 'admin' ||
          (request.auth.token.get('roles', []) is list &&
            request.auth.token.get('roles', []).hasAny(['admin']))
        );
      }

      allow read: if isOwner() || isUserAdmin();
      allow delete: if isOwner() && accountAccessAllowed();
      allow create: if isOwner()
        && request.resource.data.keys().hasOnly(['uid', 'name', 'email', 'createdAt', 'bio', 'location'])
        && request.resource.data.uid == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.name is string;
      allow update: if isOwner() && accountAccessAllowed()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'bio', 'location'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && (!('bio' in request.resource.data) || (request.resource.data.bio is string && request.resource.data.bio.size() <= 500))
        && (!('location' in request.resource.data) || (request.resource.data.location is string && request.resource.data.location.size() <= 150));

      // An admin can set only block metadata; all profile fields stay unchanged.
      allow update: if isUserAdmin() && request.auth.uid != userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['blockedAt', 'blockDurationDays', 'blockedBy'])
        && ((request.resource.data.blockedAt == request.time
          && request.resource.data.blockDurationDays in [7, 30])
          || (request.resource.data.blockedAt == null
            && request.resource.data.blockDurationDays == 0))
        && request.resource.data.blockedBy == request.auth.uid;

      match /favourites/{favouriteId} {
        allow read, delete: if isOwner() && accountAccessAllowed();
      }
    }

    // Reviews are separate from restaurant documents, so members cannot edit restaurants.
    match /reviews/{reviewId} {
      function signedIn() { return request.auth != null; }
      function validMedia(item) {
        return item is map && item.keys().hasOnly(['url', 'type'])
          && item.url is string && item.url.matches('https://res[.]cloudinary[.]com/.*')
          && item.type in ['image', 'video'];
      }
      function validMediaList(items) {
        return items is list && items.size() <= 6
          && (items.size() < 1 || validMedia(items[0]))
          && (items.size() < 2 || validMedia(items[1]))
          && (items.size() < 3 || validMedia(items[2]))
          && (items.size() < 4 || validMedia(items[3]))
          && (items.size() < 5 || validMedia(items[4]))
          && (items.size() < 6 || validMedia(items[5]));
      }
      function validContent(data) {
        return data.rating is int && data.rating >= 1 && data.rating <= 5
          && data.comment is string && data.comment.size() >= 10 && data.comment.size() <= 580;
      }
      function validHelpfulChange() {
        let before = resource.data.get('helpfulUserIds', []);
        let after = request.resource.data.helpfulUserIds;
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['helpfulUserIds'])
          && after is list && after.size() <= before.size() + 1
          && after.toSet().size() == after.size()
          && after.removeAll([request.auth.uid]) == before.removeAll([request.auth.uid]);
      }
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['restaurantId', 'userId', 'userName', 'userAvatar', 'rating', 'comment', 'diningType', 'mealTime', 'visitedWith', 'anonymous', 'media', 'helpfulUserIds', 'createdAt'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.restaurantId is string
        && reviewId == request.resource.data.restaurantId + '_' + request.auth.uid
        && get(/databases/$(database)/documents/restaurants/$(request.resource.data.restaurantId)).data.status == 'active'
        && request.resource.data.userName is string && request.resource.data.userName.size() > 0 && request.resource.data.userName.size() <= 100
        && request.resource.data.userAvatar is string
        && request.resource.data.diningType in ['Dine-in', 'Takeaway', 'Delivery']
        && request.resource.data.mealTime in ['Breakfast', 'Lunch', 'Dinner']
        && request.resource.data.visitedWith in ['Solo', 'Couple', 'Family', 'Friends']
        && request.resource.data.anonymous is bool
        && (!request.resource.data.anonymous || (request.resource.data.userName == 'Anonymous' && request.resource.data.userAvatar == ''))
        && validContent(request.resource.data) && validMediaList(request.resource.data.media)
        && request.resource.data.helpfulUserIds == []
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn() && (validHelpfulChange() || (
        resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'comment', 'diningType', 'mealTime', 'visitedWith', 'anonymous', 'media', 'userName', 'userAvatar', 'updatedAt'])
        && validContent(request.resource.data) && validMediaList(request.resource.data.media)
        && request.resource.data.diningType in ['Dine-in', 'Takeaway', 'Delivery']
        && request.resource.data.mealTime in ['Breakfast', 'Lunch', 'Dinner']
        && request.resource.data.visitedWith in ['Solo', 'Couple', 'Family', 'Friends']
        && request.resource.data.anonymous is bool
        && request.resource.data.userName is string && request.resource.data.userName.size() > 0 && request.resource.data.userName.size() <= 100
        && request.resource.data.userAvatar is string
        && (!request.resource.data.anonymous || (request.resource.data.userName == 'Anonymous' && request.resource.data.userAvatar == ''))
        && request.resource.data.updatedAt == request.time));
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;

      match /comments/{commentId} {
        allow read: if signedIn();
        allow delete: if signedIn()
          && get(/databases/$(database)/documents/reviews/$(reviewId)).data.userId == request.auth.uid;
        allow create: if signedIn() && exists(/databases/$(database)/documents/reviews/$(reviewId))
          && request.resource.data.keys().hasOnly(['userId', 'userName', 'text', 'createdAt'])
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.userName is string && request.resource.data.userName.size() > 0 && request.resource.data.userName.size() <= 100
          && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500
          && request.resource.data.createdAt == request.time;
      }
    }

    // Default deny for all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
