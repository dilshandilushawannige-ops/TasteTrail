rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Server time makes temporary blocks expire without a scheduled job.
    function accountAccessAllowed() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      return request.auth != null && (!exists(path)
        || !(get(path).data.get('blockedAt', null) is timestamp)
        || !(get(path).data.get('blockDurationDays', 0) in [7, 30])
        || request.time >= get(path).data.blockedAt + duration.value(get(path).data.blockDurationDays, 'd'));
    }
    
    // Helper function to check if user is admin
    function isAdmin() {
      // Check multiple possible admin claim structures
      return request.auth != null && (
        request.auth.token.admin == true ||
        request.auth.token.isAdmin == true ||
        request.auth.token.role == 'admin' ||
        ('admin' in request.auth.token.roles) ||
        (resource != null && request.auth.uid == resource.data.createdBy)
      );
    }
    
    // Restaurant collection rules
    match /restaurants/{restaurantId} {
      // Allow read for:
      // - Active restaurants (everyone authenticated)
      // - All restaurants (admins only)
      allow read: if request.auth != null && accountAccessAllowed() && (
        (resource.data.status == 'active') || isAdmin()
      );
      
      // Allow create: admins only
      allow create: if accountAccessAllowed() && isAdmin() &&
        // Ensure required fields are present for create
        request.resource.data.keys().hasAll([
          'name', 'category', 'status', 'createdBy', 'createdAt'
        ]) &&
        // Ensure createdBy matches current user
        request.resource.data.createdBy == request.auth.uid;
      
      // Allow update: admins only
      allow update: if accountAccessAllowed() && isAdmin() &&
        // Prevent changing createdBy and createdAt
        request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.createdAt == resource.data.createdAt;
      
      // Allow delete: admins only
      allow delete: if accountAccessAllowed() && isAdmin();
    }
    
    // Account settings only allow a user to manage their own profile.
    match /users/{userId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }

      // Only trusted authentication claims grant access to the full user list.
      function isUserAdmin() {
        return request.auth != null && accountAccessAllowed() && (
          request.auth.token.get('admin', false) == true ||
          request.auth.token.get('admin', false) == 'true' ||
          request.auth.token.get('isAdmin', false) == true ||
          request.auth.token.get('role', '') == 'admin' ||
          (request.auth.token.get('roles', []) is list &&
            request.auth.token.get('roles', []).hasAny(['admin']))
        );
      }

      allow read: if isOwner() || isUserAdmin();
      allow delete: if isOwner() && accountAccessAllowed();
      allow create: if isOwner()
        && request.resource.data.keys().hasOnly(['uid', 'name', 'email', 'createdAt', 'bio', 'location'])
        && request.resource.data.uid == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.name is string;
      allow update: if isOwner() && accountAccessAllowed()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'bio', 'location'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && (!('bio' in request.resource.data) || (request.resource.data.bio is string && request.resource.data.bio.size() <= 500))
        && (!('location' in request.resource.data) || (request.resource.data.location is string && request.resource.data.location.size() <= 150));

      // An admin can set only block metadata; all profile fields stay unchanged.
      allow update: if isUserAdmin() && request.auth.uid != userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['blockedAt', 'blockDurationDays', 'blockedBy'])
        && ((request.resource.data.blockedAt == request.time
          && request.resource.data.blockDurationDays in [7, 30])
          || (request.resource.data.blockedAt == null
            && request.resource.data.blockDurationDays == 0))
        && request.resource.data.blockedBy == request.auth.uid;

      match /favourites/{favouriteId} {
        allow read, delete: if isOwner() && accountAccessAllowed();
      }
    }

    // Default deny for all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
